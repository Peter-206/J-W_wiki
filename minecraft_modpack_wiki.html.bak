/* ============================================================== */
/* 5. TOOLTIPS & INTERACTIVE CONTROLLERS                          */
/* ============================================================== */
const floatingTooltip = document.getElementById("mcFloatingTooltip");
const tipTitle = document.getElementById("mcTipTitle");
const tipMod = document.getElementById("mcTipMod");
const tipHint = document.getElementById("mcTipHint");

// Navigation history stack for JEI modal
let recipeHistory = [];
let historyIndex = -1;

function showTooltip(itemId, x, y) {
  const meta = getItemMeta(itemId);
  if (!meta || !floatingTooltip) return;

  tipTitle.textContent = meta.name;
  tipTitle.className = "mc-tip-title " + (meta.rarity || "common");
  tipMod.textContent = meta.mod;
  tipHint.textContent = "Left-Click: View Recipe | 'A': Bookmark";

  floatingTooltip.style.display = "block";
  positionTooltip(x, y);
}

function positionTooltip(x, y) {
  if (!floatingTooltip) return;
  const padding = 15;
  let posX = x + padding;
  let posY = y + padding;

  const tipWidth = floatingTooltip.offsetWidth || 200;
  const tipHeight = floatingTooltip.offsetHeight || 60;

  if (posX + tipWidth > window.innerWidth - 10) {
    posX = x - tipWidth - 10;
  }
  if (posY + tipHeight > window.innerHeight - 10) {
    posY = y - tipHeight - 10;
  }

  floatingTooltip.style.left = posX + "px";
  floatingTooltip.style.top = posY + "px";
}

function hideTooltip() {
  if (floatingTooltip) floatingTooltip.style.display = "none";
}

// Global mouse listeners for tooltips
document.addEventListener("mousemove", (e) => {
  const target = e.target.closest("[data-item-id]");
  if (target) {
    const itemId = target.dataset.itemId;
    showTooltip(itemId, e.clientX, e.clientY);
  } else {
    hideTooltip();
  }
});

/* ============================================================== */
/* 6. JEI RENDERERS (SPRITES & TOOLTIPS)                          */
/* ============================================================== */
function renderJEI() {
  const q = jeiSearchQuery.toLowerCase().trim();
  const filtered = jeiDatabase.filter(item => {
    let matchFilter = true;
    if (jeiActiveFilter !== "All") {
      if (jeiActiveFilter.startsWith("#")) {
        matchFilter = item.tags.includes(jeiActiveFilter);
      }
    }

    if (!matchFilter) return false;
    if (!q) return true;

    if (q.startsWith("@")) {
      const modQueryTerm = q.slice(1);
      return item.modId.toLowerCase().includes(modQueryTerm) || item.mod.toLowerCase().includes(modQueryTerm);
    }
    if (q.startsWith("#")) {
      return item.tags.some(t => t.toLowerCase().includes(q));
    }

    return item.name.toLowerCase().includes(q) ||
           item.mod.toLowerCase().includes(q) ||
           item.description.toLowerCase().includes(q) ||
           item.tags.some(t => t.toLowerCase().includes(q));
  });

  jeiResultCount.innerHTML = `Showing <b>\${filtered.length}</b> of \${jeiDatabase.length} items`;
  
  if (filtered.length === 0) {
    jeiGrid.innerHTML = "";
    jeiNoResults.style.display = "block";
  } else {
    jeiNoResults.style.display = "none";
    jeiGrid.innerHTML = filtered.map(item => `
      <div class="jei-slot-card" data-item-id="\${item.id}">
        <div class="jei-slot-icon-box">\${renderItemSprite(item.id)}</div>
        <div class="jei-slot-details">
          <span class="jei-slot-name">\${item.name}</span>
          <span class="jei-slot-mod">\${item.mod}</span>
        </div>
      </div>
    `).join("");
  }
}

/* JEI Search Input Listeners */
jeiSearchInput.addEventListener("input", (e) => {
  jeiSearchQuery = e.target.value;
  renderJEI();
});

homeSearchInput.addEventListener("input", (e) => {
  jeiSearchQuery = e.target.value;
  jeiSearchInput.value = e.target.value;
});
homeSearchInput.addEventListener("keydown", (e) => {
  if (e.key === "Enter") {
    navigateTo("jei-view");
    renderJEI();
    jeiSearchInput.focus();
  }
});

jeiCategoryPills.addEventListener("click", (e) => {
  if (e.target.dataset.filter) {
    jeiCategoryPills.querySelectorAll(".pill").forEach(p => p.classList.remove("active"));
    e.target.classList.add("active");
    jeiActiveFilter = e.target.dataset.filter;
    renderJEI();
  }
});

/* ============================================================== */
/* BOOKMARKS DRAWER                                               */
/* ============================================================== */
function renderBookmarks() {
  const bookmarkedItems = jeiDatabase.filter(i => bookmarkedIds.includes(i.id));
  bookmarkCount.textContent = `\${bookmarkedItems.length} pinned`;

  if (bookmarkedItems.length === 0) {
    bookmarksGrid.innerHTML = `<span style="font-size:0.75rem; color:var(--text-dim); grid-column:span 4;">No pinned items yet. Hover item and press 'A'.</span>`;
    return;
  }

  bookmarksGrid.innerHTML = bookmarkedItems.map(item => `
    <div class="mc-slot" data-item-id="\${item.id}">
      \${renderItemSprite(item.id)}
    </div>
  `).join("");
}

function toggleBookmark(itemId) {
  if (bookmarkedIds.includes(itemId)) {
    bookmarkedIds = bookmarkedIds.filter(id => id !== itemId);
  } else {
    bookmarkedIds.push(itemId);
  }
  localStorage.setItem("jei_bookmarks", JSON.stringify(bookmarkedIds));
  renderBookmarks();
  updateBookmarkBtnState();
}

function updateBookmarkBtnState() {
  if (!currentOpenItem) return;
  const isBookmarked = bookmarkedIds.includes(currentOpenItem.id);
  recBookmarkBtn.innerHTML = isBookmarked ? "⭐ Bookmarked" : "☆ Bookmark (A)";
  recBookmarkBtn.classList.toggle("active", isBookmarked);
}

recBookmarkBtn.addEventListener("click", () => {
  if (currentOpenItem) toggleBookmark(currentOpenItem.id);
});

/* ============================================================== */
/* SPOTLIGHT ITEMS ON HOME VIEW                                   */
/* ============================================================== */
function renderSpotlight() {
  const spotlightItems = jeiDatabase.filter(i => i.spotlight);
  spotlightGrid.innerHTML = spotlightItems.map(item => `
    <div class="spotlight-card" data-item-id="\${item.id}">
      <div class="spotlight-slot">\${renderItemSprite(item.id)}</div>
      <div class="spotlight-info">
        <h4>\${item.name}</h4>
        <small>\${item.mod} • \${item.craftType}</small>
      </div>
    </div>
  `).join("");
}

/* ============================================================== */
/* RECIPE MODAL & HISTORY ENGINE                                  */
/* ============================================================== */
function openRecipeModal(itemOrId, recordHistory = true) {
  let item = typeof itemOrId === "string" ? jeiDatabase.find(x => x.id === itemOrId) : itemOrId;
  
  // If item is not in jeiDatabase (e.g. basic ingredient like diamond/stick), generate a dynamic entry
  if (!item && typeof itemOrId === "string") {
    const meta = getItemMeta(itemOrId);
    // Find recipes that use this item as an ingredient
    const usedIn = jeiDatabase.filter(d => d.grid && d.grid.includes(itemOrId));
    item = {
      id: itemOrId,
      name: meta.name,
      mod: meta.mod,
      iconFile: meta.file,
      category: "material",
      tags: ["#material", "#ingredient"],
      tier: meta.tier,
      rarity: meta.rarity,
      description: `Crafting material and vital ingredient used across \${usedIn.length} specialized recipes.`,
      craftType: "Material / Resource",
      outputCount: 1,
      grid: Array(9).fill(null),
      uses: usedIn.map(u => `Crafting ingredient for \${u.name} (\${u.mod})`)
    };
  }

  if (!item) return;

  if (recordHistory) {
    if (historyIndex < recipeHistory.length - 1) {
      recipeHistory = recipeHistory.slice(0, historyIndex + 1);
    }
    recipeHistory.push(item.id);
    historyIndex = recipeHistory.length - 1;
  }
  updateNavButtons();

  currentOpenItem = item;
  recTitle.textContent = item.name;
  recMod.textContent = `\${item.mod} • \${(item.tags || []).join(" ")}`;
  recIcon.innerHTML = renderItemSprite(item.id);
  recDesc.textContent = item.description;
  recProcessType.textContent = item.craftType || "Crafting Table (3x3)";

  mcOutputIcon.innerHTML = renderItemSprite(item.id);
  mcOutputSlot.dataset.itemId = item.id;
  mcOutputCount.textContent = item.outputCount > 1 ? item.outputCount : "";

  // Render 3x3 Grid
  const grid = item.grid || Array(9).fill(null);
  mcGrid3x3.innerHTML = grid.map((slotId, idx) => {
    if (!slotId) {
      return `<div class="mc-grid-slot" data-slot-idx="\${idx}"></div>`;
    }
    return `
      <div class="mc-grid-slot has-item" data-slot-idx="\${idx}" data-item-id="\${slotId}">
        \${renderItemSprite(slotId)}
      </div>
    `;
  }).join("");

  // Render Uses List
  const usedByRecipes = jeiDatabase.filter(d => d.grid && d.grid.includes(item.id));
  let usesHtml = "";
  if (usedByRecipes.length > 0) {
    usesHtml += usedByRecipes.map(u => `
      <div class="rec-use-item-card" data-item-id="\${u.id}">
        \${renderItemSprite(u.id)}
        <div class="rec-use-details">
          <div class="rec-use-name">\${u.name}</div>
          <div class="rec-use-desc">\${u.mod} • \${u.craftType}</div>
        </div>
      </div>
    `).join("");
  }
  if (item.uses && item.uses.length > 0) {
    usesHtml += item.uses.map(u => `<div style="padding:4px 0; color:var(--text-muted);">• \${u}</div>`).join("");
  }
  recUsesList.innerHTML = usesHtml || "<div>• Direct combat & equipment usage.</div>";

  // Meta info
  recMetaMod.textContent = item.mod;
  recMetaCat.textContent = (item.category || "General").toUpperCase();
  recMetaTier.textContent = item.tier || "Standard";

  updateBookmarkBtnState();
  switchRecipeTab("crafting");
  if (!recipeModal.open) recipeModal.showModal();
}

function updateNavButtons() {
  const backBtn = document.getElementById("recNavBack");
  const forwardBtn = document.getElementById("recNavForward");
  if (backBtn) backBtn.disabled = historyIndex <= 0;
  if (forwardBtn) forwardBtn.disabled = historyIndex >= recipeHistory.length - 1;
}

const recNavBack = document.getElementById("recNavBack");
const recNavForward = document.getElementById("recNavForward");

if (recNavBack) {
  recNavBack.addEventListener("click", () => {
    if (historyIndex > 0) {
      historyIndex--;
      openRecipeModal(recipeHistory[historyIndex], false);
    }
  });
}
if (recNavForward) {
  recNavForward.addEventListener("click", () => {
    if (historyIndex < recipeHistory.length - 1) {
      historyIndex++;
      openRecipeModal(recipeHistory[historyIndex], false);
    }
  });
}

function switchRecipeTab(tabName) {
  document.querySelectorAll(".recipe-tab-btn").forEach(btn => {
    btn.classList.toggle("active", btn.dataset.tab === tabName);
  });
  document.getElementById("recipeCraftingTab").style.display = tabName === "crafting" ? "block" : "none";
  document.getElementById("recipeUsesTab").style.display = tabName === "uses" ? "block" : "none";
  document.getElementById("recipeStatsTab").style.display = tabName === "stats" ? "block" : "none";
}

document.getElementById("recipeTabs").addEventListener("click", (e) => {
  if (e.target.dataset.tab) switchRecipeTab(e.target.dataset.tab);
});

recCloseBtn.addEventListener("click", () => {
  hideTooltip();
  recipeModal.close();
});
recipeModal.addEventListener("click", (e) => {
  if (e.target === recipeModal) {
    hideTooltip();
    recipeModal.close();
  }
});

/* ============================================================== */
/* GLOBAL CLICK LISTENER (CLICK ANY ITEM TO OPEN JEI)            */
/* ============================================================== */
document.addEventListener("click", (e) => {
  const itemElem = e.target.closest("[data-item-id]");
  if (itemElem) {
    const itemId = itemElem.dataset.itemId;
    openRecipeModal(itemId);
  }
});

/* ============================================================== */
/* GLOBAL KEYBOARD SHORTCUTS (R, U, A, /, ESC, LEFT/RIGHT)        */
/* ============================================================== */
document.addEventListener("keydown", (e) => {
  if (e.key === "/" && document.activeElement !== homeSearchInput && document.activeElement !== jeiSearchInput && document.activeElement !== modSearch && !recipeModal.open && !modModal.open) {
    e.preventDefault();
    const activeView = document.querySelector(".wiki-view.active").id;
    if (activeView === "home-view") homeSearchInput.focus();
    else if (activeView === "jei-view") jeiSearchInput.focus();
    else if (activeView === "mods-view") modSearch.focus();
    return;
  }

  // Hovered item interactions
  const hovered = document.querySelector(".jei-slot-card:hover, .mc-slot:hover, .spotlight-card:hover, .mc-grid-slot:hover, .boss-drop-tag:hover");
  if (hovered && hovered.dataset.itemId) {
    const itemId = hovered.dataset.itemId;
    if (e.key === "r" || e.key === "R") {
      openRecipeModal(itemId);
    }
    if (e.key === "u" || e.key === "U") {
      openRecipeModal(itemId);
      switchRecipeTab("uses");
    }
    if (e.key === "a" || e.key === "A") {
      toggleBookmark(itemId);
    }
  }

  // Left/Right Arrow navigation in Recipe Modal
  if (recipeModal.open) {
    if (e.key === "ArrowLeft" && historyIndex > 0) {
      historyIndex--;
      openRecipeModal(recipeHistory[historyIndex], false);
    }
    if (e.key === "ArrowRight" && historyIndex < recipeHistory.length - 1) {
      historyIndex++;
      openRecipeModal(recipeHistory[historyIndex], false);
    }
    if (e.key === "a" || e.key === "A") {
      if (currentOpenItem) toggleBookmark(currentOpenItem.id);
    }
  }
});

/* ============================================================== */
/* 7. MODS DIRECTORY MODAL & CONTROLLER                           */
/* ============================================================== */
const modModal = document.getElementById("modModal");
const modModalTitle = document.getElementById("modModalTitle");
const modModalVersion = document.getElementById("modModalVersion");
const modModalCategory = document.getElementById("modModalCategory");
const modModalDesc = document.getElementById("modModalDesc");
const modModalGuide = document.getElementById("modModalGuide");
const modModalKeyItems = document.getElementById("modModalKeyItems");
const modModalJeiBtn = document.getElementById("modModalJeiBtn");
const modModalClose = document.getElementById("modModalClose");

function openModModal(mod) {
  currentOpenMod = mod;
  modModalTitle.textContent = mod.name;
  modModalVersion.textContent = mod.version;
  modModalCategory.textContent = mod.category.toUpperCase();
  modModalDesc.textContent = mod.description;
  modModalGuide.textContent = mod.guide;
  
  modModalKeyItems.innerHTML = mod.keyItems.map(item => `
    <div class="boss-drop-tag" data-item-id="${item.toLowerCase().replace(/\\s+/g, '_')}">
      ${item}
    </div>
  `).join("");

  modModalJeiBtn.onclick = () => {
    modModal.close();
    navigateTo("jei-view");
    jeiSearchInput.value = `@${mod.id}`;
    jeiSearchQuery = `@${mod.id}`;
    renderJEI();
  };

  modModal.showModal();
}

modModalClose.addEventListener("click", () => modModal.close());
modModal.addEventListener("click", (e) => {
  if (e.target === modModal) modModal.close();
});

function renderMods() {
  const q = modSearch.value.toLowerCase().trim();
  const filtered = modsDatabase.filter(m => {
    const matchCat = activeModCategory === "all" || m.category === activeModCategory;
    const matchSearch = !q || m.name.toLowerCase().includes(q) || m.description.toLowerCase().includes(q) || m.id.toLowerCase().includes(q);
    return matchCat && matchSearch;
  });

  modsGrid.innerHTML = filtered.map(m => `
    <article class="mod-card" data-mod-id="${m.id}">
      <div class="mod-card-header">
        <div>
          <span class="mod-category-badge">${m.category}</span>
          <h3 class="mod-name">${m.name}</h3>
        </div>
        <span class="mod-version">${m.version}</span>
      </div>
      <p class="mod-desc">${m.description}</p>
      <div class="mod-key-items">
        ${m.keyItems.slice(0, 3).map(k => `<span class="mod-item-tag">${k}</span>`).join("")}
      </div>
      <div class="mod-card-actions">
        <button class="mod-action-btn view-guide-btn" onclick="openModGuide('${m.id}')">📖 Guide</button>
        <button class="mod-action-btn view-recipes-btn" onclick="filterJeiByMod('${m.id}')">⚙️ JEI</button>
      </div>
    </article>
  `).join("");
}

function openModGuide(modId) {
  const mod = modsDatabase.find(m => m.id === modId);
  if (mod) openModModal(mod);
}

function filterJeiByMod(modId) {
  navigateTo("jei-view");
  jeiSearchInput.value = `@${modId}`;
  jeiSearchQuery = `@${modId}`;
  renderJEI();
}

modSearch.addEventListener("input", renderMods);
modCategoryPills.addEventListener("click", (e) => {
  if (e.target.dataset.cat) {
    modCategoryPills.querySelectorAll(".pill").forEach(p => p.classList.remove("active"));
    e.target.classList.add("active");
    activeModCategory = e.target.dataset.cat;
    renderMods();
  }
});

/* ============================================================== */
/* 8. GLOBAL CHECKLIST CONTROLLER                                 */
/* ============================================================== */
function loadChecklistState() {
  document.querySelectorAll(".checklist-item input[type='checkbox']").forEach(cb => {
    const key = `check_\${cb.id}`;
    cb.checked = localStorage.getItem(key) === "true";
    cb.addEventListener("change", () => {
      localStorage.setItem(key, cb.checked);
      updateChecklistProgress();
    });
  });
  updateChecklistProgress();
}

function updateChecklistProgress() {
  const total = document.querySelectorAll(".checklist-item input[type='checkbox']").length;
  const checked = document.querySelectorAll(".checklist-item input[type='checkbox']:checked").length;
  const percent = total > 0 ? Math.round((checked / total) * 100) : 0;
  const fill = document.getElementById("progressFill");
  const text = document.getElementById("progressText");
  if (fill) fill.style.width = `\${percent}%`;
  if (text) text.textContent = `\${checked} of \${total} Complete (\${percent}%)`;
}

function resetChecklist() {
  if (confirm("Reset all quest progress?")) {
    document.querySelectorAll(".checklist-item input[type='checkbox']").forEach(cb => {
      cb.checked = false;
      localStorage.removeItem(`check_\${cb.id}`);
    });
    updateChecklistProgress();
  }
}

/* ============================================================== */
/* INITIALIZATION                                                 */
/* ============================================================== */
window.addEventListener("DOMContentLoaded", () => {
  renderJEI();
  renderBookmarks();
  renderSpotlight();
  renderMods();
  loadChecklistState();
});

  </script>

  <!-- Authentic Minecraft Floating Tooltip Container -->
  <div id="mcFloatingTooltip">
    <div id="mcTipTitle" class="mc-tip-title">Item Name</div>
    <div id="mcTipMod" class="mc-tip-mod">Minecraft</div>
    <div id="mcTipHint" class="mc-tip-hint">Left-Click: View Recipe | 'A': Bookmark</div>
  </div>

</body>
</html>
