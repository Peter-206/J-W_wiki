    roleClass: "support",
    icon: "🏰",
    dependency: "Forge 1.20.1",
    jarName: "citadel-1.20.1-2.4.9.jar",
    description: "Advanced mob animation, entity AI, and bone transform library powering Alex's Mobs, Ice and Fire, and Cataclysm.",
    deepDive: "Handles procedural IK animations, entity pathing mesh calculations, and custom bounding boxes for complex bosses.",
    keyItems: ["Bone Transform Engine", "IK Animation Framework"],
