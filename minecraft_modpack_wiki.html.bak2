<!-- ========================================== -->
<!-- AUTHENTIC JEI RECIPE & USES MODAL          -->
<!-- ========================================== -->
<dialog id="recipeModal">
  <div class="recipe-dialog-content">
    <div class="recipe-dialog-header">
      <div class="recipe-header-left">
        <div class="recipe-header-icon" id="recIcon">🗡️</div>
        <div class="recipe-header-text">
          <h2 id="recTitle">Item Name</h2>
          <small id="recMod">Mod Name • #tag</small>
        </div>
      </div>
      <div style="display:flex; gap:10px; align-items:center;">
        <button id="recBookmarkBtn" class="pill" style="font-size:0.8rem;">⭐ Bookmark (A)</button>
        <button class="recipe-dialog-close" id="recCloseBtn" aria-label="Close modal">×</button>
      </div>
    </div>

    <!-- Recipe Type Switcher Tabs -->
    <div class="recipe-tabs" id="recipeTabs">
      <button class="recipe-tab-btn active" data-tab="crafting">🛠️ Crafting (3x3)</button>
      <button class="recipe-tab-btn" data-tab="uses">📋 Recipe Uses</button>
      <button class="recipe-tab-btn" data-tab="stats">📊 Stats & Info</button>
    </div>

    <!-- Tab View 1: Crafting Matrix -->
    <div id="recipeCraftingTab" class="recipe-tab-content">
      <div class="mc-crafting-panel">
        <div class="mc-grid-3x3" id="mcGrid3x3"></div>
        <div class="mc-arrow-box">
          <div class="mc-craft-arrow">➔</div>
          <span class="mc-craft-type" id="recProcessType">Shaped Crafting</span>
        </div>
        <div class="mc-output-slot" id="mcOutputSlot">
          <span id="mcOutputIcon">🗡️</span>
          <span class="mc-output-count" id="mcOutputCount">1</span>
        </div>
      </div>
    </div>

    <!-- Tab View 2: Uses in Recipes -->
    <div id="recipeUsesTab" class="recipe-tab-content" style="display:none;">
      <div style="background:var(--bg); padding:18px; border-radius:var(--radius); border:1px solid var(--border);">
        <h4 style="color:var(--gold); margin-bottom:8px;">Used in following Crafts / Systems:</h4>
        <div id="recUsesList" style="font-size:0.88rem; color:var(--text-muted); line-height:1.6; display:flex; flex-direction:column; gap:8px;"></div>
      </div>
    </div>

    <!-- Tab View 3: Stats & Mod Info -->
    <div id="recipeStatsTab" class="recipe-tab-content" style="display:none;">
      <div class="recipe-meta-section">
        <div class="recipe-meta-box">
          <small>Source Mod</small>
          <b id="recMetaMod">Create</b>
        </div>
        <div class="recipe-meta-box">
          <small>Item Category / Tag</small>
          <b id="recMetaCat">Technology</b>
        </div>
        <div class="recipe-meta-box">
          <small>Rarity / Tier</small>
          <b id="recMetaTier">Epic / Tier 4</b>
        </div>
      </div>
    </div>

    <!-- Lore / Description Box -->
    <div class="recipe-desc-box" id="recDesc"></div>
  </div>
</dialog>

<!-- Detailed Mod Inspection Modal -->
<dialog id="modModal">
  <div class="modal-content">
    <div class="modal-header">
      <div class="modal-title-area">
        <div class="modal-category-tag" id="modalCatTag">Category</div>
        <h2 id="modalModTitle">Mod Name</h2>
      </div>
      <button class="modal-close-btn" id="modalCloseBtn" aria-label="Close modal">×</button>
    </div>

    <p id="modalModDesc" style="font-size:0.95rem; color:var(--text); line-height:1.6;"></p>

    <div class="modal-grid-info">
      <div class="modal-info-box">
        <small>Mod Version</small>
        <b id="modalModVersion">1.0.0</b>
      </div>
      <div class="modal-info-box">
        <small>Pack Role</small>
        <b id="modalModRole">Content Mod</b>
      </div>
      <div class="modal-info-box">
        <small>Primary Dependency</small>
        <b id="modalModDep">Forge / NeoForge</b>
      </div>
    </div>

    <div class="modal-section">
      <h4>In-Depth Wiki Overview & Mechanics</h4>
      <div id="modalDeepDive" style="font-size:0.88rem; color:var(--text-muted); line-height:1.6; display:flex; flex-direction:column; gap:10px;"></div>
    </div>

    <div class="modal-section">
      <h4>JAR Filename in Mods Folder</h4>
      <div id="modalJarName" style="font-family:ui-monospace,SFMono-Regular,Consolas,monospace; font-size:0.8rem; background:var(--bg); padding:10px 14px; border-radius:var(--radius); border:1px solid var(--border); color:var(--lime);"></div>
    </div>

    <div class="modal-section">
      <h4>Official Documentation & Links</h4>
      <div class="modal-links-row" id="modalLinks"></div>
    </div>
  </div>
</dialog>

