    description: "Uses asynchronous raytracing to skip rendering tiles and entities occluded by walls, saving massive GPU cycles.",
    deepDive: "Culls rendering of mobs, chests, and item frames hidden behind solid blocks, boosting framerates inside dense bases.",
    keyItems: ["Raytraced Occlusion", "Tile Entity Culling"],
    docUrl: "https://www.curseforge.com/minecraft/mc-mods/entity-culling"
  },
  {
    id: "citadel",
    name: "Citadel",
    version: "2.4.9",
